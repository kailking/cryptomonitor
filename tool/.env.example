APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tool
DB_USERNAME=tool
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Dedicated KeyDB logical database for 24h spot USDT turnover snapshots.
# Confirm this DB is empty before the first production run.
MARKET_VOLUME_REDIS_DB=10
MARKET_VOLUME_REDIS_PREFIX=market_volume:v1
MARKET_VOLUME_MAX_AGE_SECONDS=1800
MARKET_VOLUME_TTL_SECONDS=3600
MARKET_VOLUME_TEMP_TTL_SECONDS=600
MARKET_VOLUME_MIN_SNAPSHOT_RATIO=0.5
# Manual full market-volume:sync only; scheduled platform jobs are staggered by the shell script.
MARKET_VOLUME_PLATFORM_DELAY_MS=500
# Enables scripts/update_market_volume.sh at minute 3/18/33/48 after production validation.
MARKET_VOLUME_SCHEDULE_ENABLED=false
MARKET_VOLUME_HTTP_CONNECT_TIMEOUT=3
MARKET_VOLUME_HTTP_TIMEOUT=10
MARKET_VOLUME_HTTP_RETRIES=1
MARKET_VOLUME_HTTP_RETRY_DELAY_MS=500
MARKET_VOLUME_HTTP_USER_AGENT=cryptomonitor-market-volume/1.0

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
BITMART_API_KEY=
BITMART_API_SECRET=
BITMART_API_MEMO=
