[program:huobi_socket]
process_name=%(program_name)s_%(process_num)02d
command=php /www/wwwroot/tool/app/Client/huobi_depth.php start 
autostart=true
autorestart=true
user=root
numprocs=1
redirect_stderr=true
stdout_logfile=/www/wwwroot/tool/storage/logs/supervisor/huobi_socket.log
stopwaitsecs=3600
priority=999
