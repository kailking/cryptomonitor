[program:aex_consumer]
process_name=%(program_name)s_%(process_num)02d
command=php /www/wwwroot/tool/artisan start_aex_consumer 
autostart=true
autorestart=true
user=root
numprocs=5
redirect_stderr=true
stdout_logfile=/www/wwwroot/tool/storage/logs/supervisor/aex_consumer.log
stopwaitsecs=3600
priority=100
